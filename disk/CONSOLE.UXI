NAMESPACE console

  BIND CursorCol POS(0)
  BIND CursorRow POS(1)
  BIND nl PRINT 
  BIND spc PRINT " ";
  //BIND ? PRINT
  BIND PRINT PRINT
  BIND INPUT INPUT
  BIND LINPUT LINPUT
  //BIND clS CLS
  //BIND bell
  
  SUB print_bool(v as byte)
    IF v THEN
      PRINT "true";
    ELSE
      PRINT "false";
    END IF
  END SUB

  SUB LOCATE(x,y)
    POS(0) = x
    POS(1) = y
  END SUB

  SUB PrintAt(x,y,s$,clr as word)
    POS(0) = x
    POS(1) = 1 '--- STILL NEEDs COLOR!
    PRINT s$
  end sub
  

  SUB PRINT_USING(v$)
    ' --- do the print using stuff here in ASM or?
    ' --- as the compiler will not include this is its not using it so...
    ' --- copy from GPC

  END SUB

  
  ;BIND home()  chrout(19)
  ;BIND rvs_on() 
