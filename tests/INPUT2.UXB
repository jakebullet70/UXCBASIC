' INPUT2 -- a STRING parameter, a line cut at max, the rest of a line dropped, numbers
' in a SUB, several fields
DIM S$ * 3, N%, B
SUB READLINE(T$)
  LINPUT T$
ENDSUB
SUB READNUMBER(K) AS WORD
  INPUT K
  RETURN K + 1
ENDSUB
READLINE(S$)
PRINT S$; LEN(S$)
INPUT N%
PRINT N%
INPUT N%
PRINT N%
INPUT B
PRINT B
PRINT READNUMBER(0)
INPUT N%, S$, B
PRINT N%; S$; B
