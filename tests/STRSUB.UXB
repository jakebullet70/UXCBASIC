' STRSUB -- STRING parameters are passed by reference
DIM G$ * 20
SUB SHOW(T$)
  PRINT "<"; T$; ">"; LEN(T$)
ENDSUB
SUB SHOUT(T$)
  T$ = T$ + "!"
ENDSUB
SUB TWICE(T AS STRING, N) AS BYTE
  RETURN LEN(T + T) + N
ENDSUB
G$ = "HI"
SHOW(G$)
SHOUT(G$)
SHOW(G$)
SHOW("LIT")
SHOUT("LIT")
SHOW(G$ + "?")
PRINT TWICE(G$, 1); TWICE("AB", 0)
SHOW(MID$(G$, 2) + STR$(TWICE("X", 3)))
