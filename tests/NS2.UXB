' nested and reopened namespaces, relative names, BIND
DIM TOTAL%
NAMESPACE OUTER
  DIM A
  NAMESPACE INNER
    DIM B
    SUB SETB(V)
      B = V
      A = V + 1
      TOTAL% = TOTAL% + V
    ENDSUB
  END NAMESPACE
  SUB USEINNER()
    INNER.SETB(10)
  ENDSUB
ENDNAMESPACE
NAMESPACE OUTER
  DIM C
END NAMESPACE
SUB SHOW(N)
  DIM SEEN
  SEEN = N + 1
ENDSUB
OUTER.USEINNER()
OUTER.C = 3
SHOW(77)
PRINT OUTER.A; OUTER.INNER.B; OUTER.C; TOTAL%
BIND I = OUTER.INNER
BIND S = I.SETB
BIND T% = TOTAL%
S(4)
PRINT I.B; T%
