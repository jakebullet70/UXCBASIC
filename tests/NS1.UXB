' namespaces: bare names inside, qualified names outside, a main name of the same spelling
NAMESPACE GFX
  DIM COLOR
  VAR SIZE AS WORD
  SUB SETCOLOR(C)
    COLOR = C
    SIZE = SIZE + 1
  ENDSUB
  SUB TWICE%(N%)
    RETURN N% * 2
  ENDSUB
END NAMESPACE
DIM COLOR
COLOR = 9
GFX.SETCOLOR(5)
CALL GFX.SETCOLOR(6)
PRINT COLOR; GFX.COLOR; GFX.SIZE; GFX.TWICE%(21)
POKE @GFX.COLOR, 8
PRINT PEEK(@GFX.COLOR)
