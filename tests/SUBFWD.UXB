' SUBFWD -- calls before their SUB, locals, a local that hides a global, FOR in both
DIM I, X%, K
X% = 100
K = 4
FOR I = 1 TO K - 1
  CALL LOOP3(I)
NEXT I
PRINT X%
PRINT SQ%(12)
END
SUB LOOP3(N)
  DIM J, X%
  X% = 0
  FOR J = 1 TO N * 1
    X% = X% + J
  NEXT J
  PRINT N; X%
ENDSUB
SUB SQ%(V%)
  RETURN V% * V%
ENDSUB
