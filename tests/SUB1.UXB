' SUB1 -- SUBs with and without a value, CALL and a bare call, RETURN early
DIM T%, B
SUB ADD%(A%, B%)
  RETURN A% + B%
ENDSUB
SUB SHOW(N)
  PRINT N
ENDSUB
SUB TWICE(X AS WORD) AS WORD
  RETURN X * 2
END SUB
SUB EARLY(N)
  IF N > 5 THEN RETURN
  PRINT "SMALL"; N
ENDSUB
T% = ADD%(2, 3)
PRINT T%
CALL SHOW(7)
SHOW(8)
PRINT TWICE(300)
EARLY(3)
EARLY(9)
B = 4
PRINT ADD%(B, 1000) + 1
SUB NOARGS() AS BYTE
  RETURN 42
ENDSUB
PRINT NOARGS()
CALL NOARGS()
