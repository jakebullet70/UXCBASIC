' CONST -- named numbers: folded as numbers, by mark or AS, in a namespace and a SUB
CONST MAX_LEN = 80
CONST ROWS = 2 * 30, COLS = MAX_LEN + 1
CONST BASE% = $9F20
CONST BIG AS WORD = 1000
DIM A(ROWS / 10)
DIM W%
PRINT MAX_LEN; ROWS; COLS; BASE%; BIG
W% = BASE% + 1
PRINT W% - BASE%
A(ROWS / 10 - 1) = MAX_LEN
PRINT A(5)
NAMESPACE SCREEN
  CONST WIDTH = 80
  SUB HALF(N)
    CONST TWO = 2
    PRINT N / TWO
  ENDSUB
END NAMESPACE
PRINT SCREEN.WIDTH
SCREEN.HALF(SCREEN.WIDTH)
BIND SW = SCREEN.WIDTH
PRINT SW
